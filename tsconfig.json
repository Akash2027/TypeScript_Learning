{
    "compilerOptions": {
        "types": ["node"],
        "target": "ES2022",
        "module": "CommonJS",
        "rootDir": ".",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": [
        "concepts/**/*.ts",
        "mini_project/**/*.ts",
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}